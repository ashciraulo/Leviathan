; Engine configuration file.
; Godot 4.7. Open this folder with the Godot editor (Project Manager > Import).

config_version=5

[application]

config/name="Leviathan"
config/description="An original top-down action-adventure on the Shellcoast. Prototype build."
config/version="0.1.0"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Events="*res://scripts/autoload/events.gd"
Settings="*res://scripts/autoload/settings.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Feel="*res://scripts/autoload/feel.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom_font="res://assets/fonts/tide.fnt"
theme/default_font_antialiasing=0
theme/default_font_hinting=0

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.en.translation")
locale/fallback="en"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_attack"
2d_physics/layer_5="enemy_hurtbox"
2d_physics/layer_6="enemy_attack"
2d_physics/layer_7="player_hurtbox"
2d_physics/layer_8="water"
2d_physics/layer_9="pit"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.04, 0.06, 0.1, 1)
