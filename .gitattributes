# Normalise line endings for text files.
* text=auto eol=lf

# Large binary audio and art source files go through Git LFS (install with
# `git lfs install`). Pixel-art PNGs are tiny, so they stay in plain git.
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.flp filter=lfs diff=lfs merge=lfs -text
*.pxo filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text

# Sound effects and ambience made by tools/sfx_gen.py are small and rebuilt
# from code, so they stay in plain git (no LFS bandwidth on every CI run).
audio/sfx/*.wav -filter -diff -merge -text
audio/ambience/*.wav -filter -diff -merge -text
